import numpy as np
import soundfile as sf
import matplotlib.pyplot as plt

from scipy import signal
from google.colab import files
from IPython.display import Audio, display

# 1. Upload audio
uploaded = files.upload()
filename = next(iter(uploaded))

# 2. Read audio
x, fs = sf.read(filename)

print("Sample rate:", fs)
print("Duration:", len(x) / fs, "seconds")

# 3. Design Butterworth filters
bass_filter = signal.butter(
    4, 250, btype="lowpass", fs=fs, output="sos"
)

mid_filter = signal.butter(
    4, [250, 4000], btype="bandpass", fs=fs, output="sos"
)

treble_filter = signal.butter(
    4, 4000, btype="highpass", fs=fs, output="sos"
)

# 4. Separate frequency bands
bass = signal.sosfiltfilt(bass_filter, x, axis=0)
mid = signal.sosfiltfilt(mid_filter, x, axis=0)
treble = signal.sosfiltfilt(treble_filter, x, axis=0)

# 5. Set independent gains (dB)
bass_db = 6
mid_db = 0
treble_db = -3

gb = 10 ** (bass_db / 20)
gm = 10 ** (mid_db / 20)
gt = 10 ** (treble_db / 20)

# 6. Recombine frequency bands
y = gb * bass + gm * mid + gt * treble

# 7. Prevent clipping
peak = np.max(np.abs(y))

if peak > 0.999:
    y *= 0.999 / peak

# 8. Play original and equalized audio
print("Original Audio:")
display(Audio(x.T if x.ndim == 2 else x, rate=fs))

print("Equalized Audio:")
display(Audio(y.T if y.ndim == 2 else y, rate=fs))

# 9. Save output
sf.write("equalized_audio.wav", y, fs)

# 10. Plot frequency spectrum
plt.figure(figsize=(12, 5))

for audio, label in [(x, "Original"), (y, "Equalized")]:
    mono = np.mean(audio, axis=1) if audio.ndim == 2 else audio

    frequencies = np.fft.rfftfreq(len(mono), 1/fs)
    spectrum = np.abs(np.fft.rfft(mono * np.hanning(len(mono))))

    magnitude_db = 20 * np.log10(np.maximum(spectrum, 1e-10))

    plt.semilogx(frequencies, magnitude_db, label=label)

plt.xlabel("Frequency (Hz)")
plt.ylabel("Magnitude (dB)")
plt.title("Original vs Equalized Audio")
plt.xlim(20, fs/2)
plt.grid()
plt.legend()
plt.show()

# 11. Download result
files.download("equalized_audio.wav")
